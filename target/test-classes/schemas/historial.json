{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["codigoAlumno", "alumno", "carrera", "cursos", "creditosAprobados", "promedioPonderado"],
  "properties": {
    "codigoAlumno": { "type": "string", "pattern": "^i[0-9]{9}$" },
    "alumno": { "type": "string", "minLength": 1 },
    "carrera": { "type": "string" },
    "cursos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["periodo", "codigoCurso", "curso", "creditos", "nota", "condicion"],
        "properties": {
          "periodo": { "type": "string", "pattern": "^[0-9]{4}-[12]$" },
          "codigoCurso": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{4}$" },
          "curso": { "type": "string" },
          "creditos": { "type": "integer", "minimum": 1 },
          "nota": { "type": "number", "minimum": 0, "maximum": 20 },
          "condicion": { "enum": ["APROBADO", "DESAPROBADO"] }
        }
      }
    },
    "creditosAprobados": { "type": "integer", "minimum": 0 },
    "promedioPonderado": { "type": "number", "minimum": 0, "maximum": 20 }
  }
}