{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["codigoAlumno", "cursos", "creditos", "subtotal", "descuento", "total"],
  "properties": {
    "codigoAlumno": { "type": "string", "pattern": "^i[0-9]{9}$" },
    "cursos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{4}$" }
    },
    "creditos": { "type": "integer", "minimum": 1 },
    "subtotal": { "type": "number", "minimum": 0 },
    "descuento": { "type": "integer", "minimum": 0, "maximum": 100 },
    "total": { "type": "number", "minimum": 0 }
  }
}