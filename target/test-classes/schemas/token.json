{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["accessToken", "refreshToken", "tipo", "expiraEn", "username", "rol"],
  "properties": {
    "accessToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
    "refreshToken": { "type": "string", "minLength": 20 },
    "tipo": { "enum": ["Bearer"] },
    "expiraEn": { "type": "integer", "minimum": 1 },
    "username": { "type": "string", "minLength": 1 },
    "rol": { "enum": ["ADMIN", "DOCENTE", "ALUMNO"] }
  }
}