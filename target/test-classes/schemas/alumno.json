{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["codigo", "nombres", "apellidos", "email", "promedio", "tieneDeuda", "carrera"],
  "properties": {
    "codigo": { "type": "string", "pattern": "^i[0-9]{9}$" },
    "nombres": { "type": "string", "minLength": 1 },
    "apellidos": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
    "promedio": { "type": "number", "minimum": 0, "maximum": 20 },
    "tieneDeuda": { "type": "boolean" },
    "carrera": { "type": "string" },
    "claveTemporal": { "type": "string", "minLength": 8 }
  }
}